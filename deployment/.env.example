# OSM account for Geofabrik's internal download server. Leave empty to use the public server.
GEOFABRIK_OSM_USER=
GEOFABRIK_OSM_PASSWORD=

# Push notifications via ntfy (scripts/notify.py). Leave NTFY_URL empty to only log.
NTFY_URL=
# Token of a publish-only ntfy user ("ntfy token add <user>")
NTFY_TOKEN=
# Optional, defaults: osm-alerts / osm-alkis
NTFY_TOPIC_ALERTS=
NTFY_TOPIC_ALKIS=
# Optional: alert after N consecutive failed runs instead of the default, per key or
# key prefix, e.g. "wfs=3,gate=6,pbf:nds=1" (keys: python scripts/notify.py status)
NOTIFY_THRESHOLDS=
